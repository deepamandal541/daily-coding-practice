
import java.util.*;

class Main
{
    static boolean isPrime(int num){
        for(int i = 2;i*i <= num;i++){
            if(num %i == 0){
                return false;
            }
        }
        return true;
    }

static  void  removeComposite(ArrayList<Integer> li){
    for(int i = 0 ;i < li.size();i++){
        int val = li.get(i);
        boolean isPrimenum = isPrime(val);
        if(isPrimenum == false){
            li.remove(i);
            i--;
        }
    }
}
