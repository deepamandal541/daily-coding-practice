import java.util.*;

public class Main {
    public static int[] findPosition(int arr[], int n,int tar)
    {
        // Write code here       
         int[] failure = {-1, -1};

        if (arr.length == 0) {
            return failure;
        }

        if (arr.length == 1 && arr[0] == tar) {
            int[] x = {0, 0};
            return x;
        }

        int lo = 0;
        int hi = arr.length - 1;
        int firstocc = -1;

        // Find First Occurrence
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;

            if (arr[mid] == tar) {
                firstocc = mid;
                hi = mid - 1;
            } else if (arr[mid] > tar) {
                hi = mid - 1;
            } else {
                lo = mid + 1;
            }
        }

        lo = 0;
        hi = arr.length - 1;
        int lastocc = -1;

        // Find Last Occurrence
        while (lo <= hi) {
            int mid = lo + (hi - lo) / 2;

            if (arr[mid] <= tar) {
                if (arr[mid] == tar) lastocc = mid;
                lo = mid + 1;
            } else {
                hi = mid - 1;
            }
        }

        int[] ans = {firstocc, lastocc};
        return ans;
    }

    public static void main(String[] args) {

        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int tar = sc.nextInt();   // changed here also
        int array[] = new int[n];

        for (int i = 0; i < n; i++) {
            array[i] = sc.nextInt();
        }

        int result[] = findPosition(array, n, tar);
        System.out.println(result[0] + " " + result[1]);
    }
}

        
            
