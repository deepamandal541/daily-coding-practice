import java.util.*;
import java.io.*;
class Solution
{
    public static boolean isPossible(int arr[], int panalty, int operations){
       int op = 0;


       for(int i = 0; i < arr.length; i++){
           op += (arr[i] - 1) / panalty;
       }


       return op <= operations;
   }
    public static int solve(int n,int m,int arr[])
    {

        // Write your code here
        int s = 1;
       int e = 0;
       for(int i = 0; i < n; i++){
           e = Math.max(e, arr[i]);
       }


       int ans = 0;


       while(s <= e){
           int mid = s + (e - s) / 2;
           if(isPossible(arr, mid, m)){
               ans = mid;
               e = mid - 1;
           }
           else{
               s = mid + 1;
           }
       }


       return ans;
      
   }
}

    

