import java.io.*;
import java.util.*;
 
class Node{
    int data;
    Node next;
    Node(int data){
        this.data = data;
        next = null;
    }
}
class LinkedList{
    Node head;
    void add(int data ){
        Node new_node = new Node(data);
        if(head == null){
            head = new_node;
            return;
        }
        Node current = head;
        while(current.next !=null){
            current = current.next;
        }
        current.next = new_node;
    }
}

class Solution {
    public Node partition(Node head, int x) {
        // Your code here
        // create two dummy heads
        Node headL = new Node(-1);
        Node headB = new Node(-1);
        Node tempL = headL,tempB = headB;


        //join odd and even nodes to their res
        while(head != null){
            if(head.data < x){
                tempL.next = head;
                tempL = tempL.next;
            }
            else{
                tempB.next = head;
                tempB = tempB.next;
            }
            head = head.next;

        }
        //if(tempL != null){
            tempL.next = null;

        //}
        //if(tempB != null){
            tempB.next = null;
       // }
        // Remove the dummmy node;
        headL = headL.next;
        headB = headB.next;

        // if no even nodes,return odd LinkedList
        if(headL == null){
            return headB;
        }
        // attach odd list to the end of even
        Node tail = headL;
        while(tail.next != null){
        tail = tail.next;
    }
    tail.next = headB;
    return headL;
}
}
