import java.util.*;

class Solution {
    public int MaxSum(int[] arr, int n) {
        // Write your code here
        int kadane=Integer.MIN_VALUE,totalSum=0,curr=0;
       for(int i=0;i<n;i++){
           totalSum+=arr[i];
           curr+=arr[i];
           kadane=Math.max(kadane,curr);
           if(curr<0) curr=0;
       }
       curr=0;
       int mini=Integer.MAX_VALUE;
       for(int i=0;i<n;i++){
           curr+=arr[i];
           mini=Math.min(mini,curr);
           if(curr>0) curr=0;
       }
       return Math.max(kadane,totalSum-mini);


    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int[] arr = new int[n];
        for(int i = 0; i < n; i++)
            arr[i] = sc.nextInt();
	    Solution Obj = new Solution();
        int ans = Obj.MaxSum(arr, n);
        System.out.println(ans);
    }
}

