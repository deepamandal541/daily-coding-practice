Last Occurence Index


import java.util.Scanner;
class Main {
	public static void main(String[] args) {
		Scanner s = new Scanner(System.in);
        int N = s.nextInt();
		int[] A = new int[N];
		for(int i = 0; i < N; i++){
			A[i] = s.nextInt();
		}
		int T = s.nextInt();
		System.out.println(lastIndex(A, T, 0));
	}

	static int lastIndex(int arr[],int target,int srtIndex)
	{
		//Write your code here
		if(srtIndex == arr.length)
		return -1;
		int index = lastIndex(arr,target,srtIndex+1);
		if(index != -1)
		return index;

		if(arr[srtIndex] == target)
		return srtIndex;

		return-1;
	}
	
}


