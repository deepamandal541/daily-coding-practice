import java.io.*;
import java.util.*;
class Solution {
    public boolean compare(int []freq_s,int []freq_t){
       for(int i=0;i<256;i++){
           if(freq_s[i]<freq_t[i]) return false;
       }
       return true;
   }
    public String minWindow(String s, String t) {
		// write code here
        int []freq_s=new int[256];
       int []freq_t=new int[256];


       for(int i=0;i<t.length();i++){
           freq_t[t.charAt(i)]++;
       }


       int l=0,r=0,min_length=Integer.MAX_VALUE,min_length_start=-1;


       while(r<s.length()){
           freq_s[s.charAt(r)]++;
           while(compare(freq_s,freq_t)==true){
               //contraction
               if(r-l+1<min_length){
                   min_length=r-l+1;
                   min_length_start=l;
               }
               freq_s[s.charAt(l)]--;
               l++;
           }
 r++;
       }
       if(min_length_start==-1) return "";
       return s.substring(min_length_start,min_length_start+min_length);

    }
}

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s,t;
        s = sc.next();
		t = sc.next();
        Solution Obj = new Solution();
        System.out.print(Obj.minWindow(s,t));
    }
}

