import java.util.*;
class Solution{
    static int[] SlidingWindowMaximum(int N, int K, int[] arr){
        // write code here
       
int []ans=new int[N-K+1];
       Deque<Integer> dq=new LinkedList<>();


       for(int i=0;i<K;i++){
           while(dq.size()>0 && arr[i]>arr[dq.peekLast()]){
               dq.removeLast();
           }
           dq.addLast(i);
       }
       for(int i=K;i<N;i++){
           ans[i-K]=arr[dq.peek()];
           while(dq.size()>0 && dq.peek()<=i-K){
               dq.removeFirst();
           }


           while(dq.size()>0 && arr[i]>arr[dq.peekLast()]){
               dq.removeLast();
           }
           dq.addLast(i);
       }
       ans[ans.length-1]=arr[dq.peek()];


       return ans;

    }
}

public class Main {
    public static void main(String[] args) throws Throwable {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int k = sc.nextInt();
        int nums[]=new int[n];
        for(int i = 0; i < n; i++)
        {
            nums[i] = sc.nextInt();
        }
        Solution obj = new Solution();
        int[] ans=obj.SlidingWindowMaximum(n,k,nums);
        for(int i=0;i<ans.length;++i){
            System.out.print(ans[i] + " ");
        }
    }
}


