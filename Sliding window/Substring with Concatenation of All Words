import java.util.*;

class Solution {
    public List<Integer> findSubstring(String s, String[] words) {
        // write code here
        HashMap<String, Integer> wordMap= new HashMap<>();
       int n=words.length;
       for(int i=0;i<n;i++){
           wordMap.put(words[i],wordMap.getOrDefault(words[i],0)+1);
       }
       int wordLen=words[0].length();
       List<Integer> ans= new ArrayList<>();


       for(int i=0;i<=s.length()-n*wordLen;i++){
           HashMap<String, Integer> seenMap=new HashMap<>();
           for(int j=0;j<n;j++){
               //generating the substring
               String temp=s.substring(i+j*wordLen,i+(j+1)*wordLen);
               if(!wordMap.containsKey(temp)) break;
               seenMap.put(temp,seenMap.getOrDefault(temp,0)+1);
           }
           //compare both the hashmaps
           boolean flag=true;
           for(String str: wordMap.keySet()){
               if(!seenMap.containsKey(str) || seenMap.get(str)!=wordMap.get(str)){
                   flag=false;
               }
           }
           if(flag==true){
               ans.add(i);
           }
       }
       return ans;

    }
}

public class Main {
    public static void main(String[] args) {
        Scanner scn = new Scanner(System.in);
        String str = scn.next();
        int n = scn.nextInt();
        String[] words = new String[n];
        for(int i=0;i<n;i++){
            words[i] = scn.next();
        }
        Solution Obj =  new Solution();
        List<Integer> indexes = Obj.findSubstring(str,words);
        Collections.sort(indexes);
        for(int i=0;i<indexes.size();i++){
            System.out.print(indexes.get(i) + " ");
        }
        System.out.println();
    }
}


