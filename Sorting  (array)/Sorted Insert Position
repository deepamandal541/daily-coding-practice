import java.io.*;
import java.util.*;

public class Main {

    public static int searchInsert(int[] a, int b) {
        // Write code here
        int left = 0 ; 
        int right = a.length - 1;

        while(left <= right){
            int mid = left +(right - left)/2;
            if(a[mid] == b ){
                return mid;
            }else if(a[mid] < b){
                left = mid+1;
            }else{
                right = mid -1;
            }
        }
        return left;
    }
    
    public static void main(String args[]) {
        Scanner sc = new Scanner(System.in);
        int N = sc.nextInt();
        int[] A = new int[N];
        for(int i=0;i<N;i++){
            A[i] = sc.nextInt();
        }
        int B = sc.nextInt();
        System.out.println(searchInsert(A,B));
    }
}


