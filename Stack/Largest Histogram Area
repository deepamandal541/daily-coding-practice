import java.util.*;
import java.lang.*;
import java.io.*;

class Main {
    
    
	public static void main (String[] args) throws IOException {
	BufferedReader br = new BufferedReader(new InputStreamReader(System.in));	
        long n = Long.parseLong(br.readLine().trim());
        String inputLine[] = br.readLine().trim().split(" ");
        long[] arr = new long[(int)n];
        for(int i=0; i<n; i++)arr[i]=Long.parseLong(inputLine[i]);
        System.out.println(new Solution().maximumArea(arr, n));
	}
}

class Solution {
    public static long maximumArea(long hist[], long n) {
        int size = (int)n;
        
        int[] nsel = new int[size];
        Stack<Integer> st = new Stack<>();

        // Next Smaller Element Left
        for(int i = 0; i < size; i++){
            long val = hist[i];

            while(st.size() > 0 && val <= hist[st.peek()]){
                st.pop();
            }

            if(st.size() == 0){
                nsel[i] = -1;
            }else{
                nsel[i] = st.peek();
            }

            st.push(i);
        }

        int[] nser = new int[size];
        st = new Stack<>();

        // Next Smaller Element Right
        for(int i = size - 1; i >= 0; i--){
            long val = hist[i];

            while(st.size() > 0 && val <= hist[st.peek()]){
                st.pop();
            }

            if(st.size() == 0){
                nser[i] = size;
            }else{
                nser[i] = st.peek();
            }

            st.push(i);
        }

        long maxarea = 0;

        for(int i = 0; i < size; i++){
            long currarea = hist[i] * (nser[i] - nsel[i] - 1);
            maxarea = Math.max(currarea, maxarea);
        }

        return maxarea;
    }
}




